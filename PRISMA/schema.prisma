generator client {
   provider = "prisma-client-js"
   output   = "../generated/client"
}

datasource db {
   provider = "postgresql"
   url      = env("DATABASE_URL")
}

model user{
   id        Int      @id @default(autoincrement())
   name      String?
   email     String   @unique
   password  String?
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
}

enum Role {
   USER
   ADMIN
}